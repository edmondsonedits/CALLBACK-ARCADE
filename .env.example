OPENAI_API_KEY=
# Image-only key: enables the host's ChatGPT Images · Low option without enabling paid lore.
OPENAI_IMAGE_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.6-terra
OPENAI_TEXT_REASONING_EFFORT=low
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
CLOUDFLARE_TEXT_MODEL=@cf/meta/llama-3.1-8b-instruct-fast
RATE_LIMIT_HMAC_SECRET=
CALLBACK_ENV=development
# King Prompter real-time Arcade Worker. Use HTTPS in production.
ARCADE_WORKER_URL=http://127.0.0.1:8787
ARCADE_TICKET_SECRET=
ARCADE_CONTROL_SECRET=
ARCADE_CALLBACK_SECRET=

# Royal Sumo free-tier pilot; secret is server-only.
PARTY_WORKER_URL=
PARTY_SECRET=

# Allowance protection: leave disabled until the owner verifies grant and billing.
OPENAI_IMAGES_ENABLED=false
OPENAI_IMAGES_CREDIT_WINDOW=
OPENAI_IMAGES_STOP_AT=
OPENAI_IMAGES_MAX_REQUESTS=1000
OPENAI_IMAGES_MAX_DAILY_REQUESTS=300
OPENAI_IMAGES_MAX_ROOM_REQUESTS=100
