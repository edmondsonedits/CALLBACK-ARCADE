{
  "name": "callback-royal-sumo",
  "main": "worker.mjs",
  "compatibility_date": "2026-08-22",
  "assets": {"directory": "../source", "binding": "ASSETS", "run_worker_first": ["/api/*"]},
  "durable_objects": {"bindings": [{"name": "SUMO_ROOMS", "class_name": "SumoRoom"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["SumoRoom"]}]
}
