{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "callback-arcade-local",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-22",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "arcade-catalog", "database_id": "00000000-0000-0000-0000-000000000001", "migrations_dir": "db/migrations" }]
}
