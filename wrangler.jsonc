{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "callback-arcade",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-22",
  "assets": { "directory": "./.local/site-assets", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "arcade-catalog", "database_id": "local-only-placeholder", "migrations_dir": "db/migrations" }],
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "ArcadeRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ArcadeRoom"] }]
}
